<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- 安全头 -->
        <httpProtocol>
            <customHeaders>
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="DENY" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <!-- CSP：按实际使用面收紧。
                     允许：内联脚本/样式（index.html 内联 Twemoji 初始化 + style 属性）、
                     jsdelivr（Twemoji/CDN，仅安全上下文使用）、v2.xxapi.cn（运势 API）、
                     blob:（connect-src —— Live2D waifu-tips.js 用 Blob URL 加载本地 JSON 数据；
                     media-src —— 本地音乐选择功能用 createObjectURL 生成的音频地址，
                     缺少 blob: 时音频会被 CSP 静默拦截、只触发 error 事件）。
                     注意：不得加 upgrade-insecure-requests —— 源站服务在 HTTP 上，
                     该指令会把所有子资源请求强制升级为 HTTPS，直接破坏页面加载。 -->
                <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.jsdelivr.net; font-src 'self'; media-src 'self' blob:; connect-src 'self' blob: https://v2.xxapi.cn; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" />
                <!-- HSTS：仅在 HTTPS 响应中生效。当前 307 到 HTTP 源站的架构下浏览器收不到；
                     将来启用 HTTPS 回源后自动生效，无需改动。 -->
                <add name="Strict-Transport-Security" value="max-age=31536000" />
            </customHeaders>
        </httpProtocol>

        <!-- 启用静态内容压缩（CSS/JS/HTML 大幅减小传输体积） -->
        <urlCompression doStaticCompression="true" doDynamicCompression="true" />

        <!-- 禁止目录浏览 -->
        <directoryBrowse enabled="false" />

        <!-- 注册 .woff2 MIME（IIS 8.5/Server 2012 R2 默认不含；缺失时 woff2 一律 404，即使文件存在）。
             注意：mimeMap 必须在 staticContent 内与 clientCache 共存（同段只能出现一次） -->
        <staticContent>
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
            <!-- 默认不缓存（HTML 每次都验证最新版） -->
            <clientCache cacheControlMode="DisableCache" />
        </staticContent>
    </system.webServer>

    <!-- CSS/JS: 缓存 1 天（代码更新最快，1 天可自然生效） -->
    <location path="css">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
            </staticContent>
        </system.webServer>
    </location>
    <location path="js">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
            </staticContent>
        </system.webServer>
    </location>

    <!-- assets 静态资源: 缓存 7 天（头像/图标/字体/Twemoji 几乎不变，取上限） -->
    <location path="assets">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
            </staticContent>
        </system.webServer>
    </location>

    <!-- 音乐文件缓存 30 天：位于 assets 下，此 location 覆盖父级的 7 天（IIS 按更具体的路径取配置）。
         歌单变化不频繁，30 天可减少大文件重复下载 -->
    <location path="assets/music">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
            </staticContent>
        </system.webServer>
    </location>

    <!-- Live2D 模型/SDK/脚本: 缓存 7 天（模型与 SDK 不变，取上限） -->
    <location path="live2d">
        <system.webServer>
            <staticContent>
                <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
            </staticContent>
        </system.webServer>
    </location>
</configuration>
